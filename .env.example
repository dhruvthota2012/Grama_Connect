# ==============================================================================
# GramaConnect — Environment Variables Checklist
# Add these in Vercel > Settings > Environment Variables (Names only, no secrets committed)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration
# ------------------------------------------------------------------------------
# Optional: External Backend API base URL.
# Leave unset or empty on Vercel to automatically use same-origin serverless functions (/api/...).
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. Authentication & Serverless Security
# ------------------------------------------------------------------------------
# Secret key used for signing stateless HMAC tokens for OTP verification across serverless instances.
AUTH_SECRET=

# Optional: Universal fallback OTP code for simulation/testing (defaults to 123456 if unset).
DEMO_OTP=

# ------------------------------------------------------------------------------
# 3. SMS Provider (OTP Gateway) Configuration
# Leave unset to run in Demonstration Simulation Mode (code: 123456).
# Supported values: fast2sms | msg91 | twilio
# ------------------------------------------------------------------------------
SMS_PROVIDER=

# API Key / Authorization Token for your selected SMS provider
SMS_API_KEY=

# Optional: MSG91 DLT Template ID (Required if using MSG91 in India)
SMS_TEMPLATE_ID=
MSG91_TEMPLATE_ID=

# Optional: Twilio Configuration (Required only if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# 4. Text-To-Speech (TTS) Cloud Audio (Optional)
# If omitted, uses local pre-recorded audio assets or browser speech synthesis.
# ------------------------------------------------------------------------------
GOOGLE_TTS_API_KEY=

# Preferred Google Cloud Voice Identifiers
TTS_VOICE_TE=te-IN-Standard-A
TTS_VOICE_HI=hi-IN-Standard-A
TTS_VOICE_EN=en-IN-Standard-A
