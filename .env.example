# ==============================================================================
# GramaConnect: Environment Variables
# Real values go only in this local file and in Vercel > Settings > Environment Variables.
# Never commit this file to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED
# ------------------------------------------------------------------------------
# Secret used to sign OTP tokens. Replace with your own long random string (40+ characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ------------------------------------------------------------------------------
# 2. OPTIONAL: leave commented out to run in Demo Mode (OTP code is always 123456)
# ------------------------------------------------------------------------------
# Frontend: only set if your backend is hosted somewhere other than Vercel.
# VITE_API_URL=https://your-backend.example.com

# Change the demo OTP (default is 123456).
# DEMO_OTP=123456

# ------------------------------------------------------------------------------
# 3. OPTIONAL: real SMS. Uncomment and fill ONLY when you have a provider account.
# Supported values: fast2sms | msg91 | twilio
# ------------------------------------------------------------------------------
# SMS_PROVIDER=fast2sms
# SMS_API_KEY=your_provider_api_key

# MSG91 only (DLT-approved template ID)
# MSG91_TEMPLATE_ID=your_template_id
# SMS_TEMPLATE_ID=your_template_id

# Twilio only
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_FROM_NUMBER=+10000000000

# ------------------------------------------------------------------------------
# 4. OPTIONAL: cloud voice. Without it, the browser's built-in speech is used.
# ------------------------------------------------------------------------------
# GOOGLE_TTS_API_KEY=your_google_tts_key
TTS_VOICE_TE=te-IN-Standard-A
TTS_VOICE_HI=hi-IN-Standard-A
TTS_VOICE_EN=en-IN-Standard-A