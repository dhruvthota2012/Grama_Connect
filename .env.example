# ==============================================================================
# GramaConnect — Smart Agricultural Service Kiosk Environment Variables
# ==============================================================================

# Optional: Google Cloud Text-to-Speech API Key
# If provided, the server securely synthesizes speech via official Google Cloud TTS (te-IN, hi-IN, en-IN).
# If omitted, GramaConnect automatically uses installed browser voices, local pre-generated MP3 files,
# or the development proxy fallback.
GOOGLE_TTS_API_KEY=

# Optional: Preferred Google Cloud Voice Identifiers
# Standard/Neural/Chirp3 official Google Cloud voices:
TTS_VOICE_TE=te-IN-Standard-A
TTS_VOICE_HI=hi-IN-Standard-A
TTS_VOICE_EN=en-IN-Standard-A
